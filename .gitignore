# Miscellaneous
.local/
exports/
.env
.env.*
!.env.example
!.env.*.example
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Deliverables contain binaries and are regenerated by scripts/package.ps1
/dist/

# Installation-specific visitor identities; never share these between users.
visitor-v1.json
visitor-v1.json.tmp
search-visitor.json
native-search-identity.properties

# Raw network captures may contain credentials and temporary playback URLs.
*.har
*.pcap
*.pcapng

# Signing material and JVM diagnostic dumps (public certificates stay trackable).
*.keystore
*.jks
*.p12
*.pfx
*.hprof
